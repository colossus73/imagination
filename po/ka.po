#: ../src/export.c:1528
msgid ""
"The range of the CRF scale is 0–51:\n"
"0 = lossless\n"
"17-28 = visually lossless (still compressed but unnoticeable)\n"
"23 = high quality\n"
"51 = worst quality possible"
msgstr ""
"CRF-ის შუალედი დიაპაზონიდან 0-51:\n"
"0 = კარგვების გარეშე\n"
"17-28 = ვიზუალურად კარგვის გარეშე (შეკუმშული, მაგრამ შეუმჩნევლად)\n"
"23 = მაღალი ხარისხი\n"
"51 = ყველაზე ცუდი ხარისხი"
